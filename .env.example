# =============================================================================
# Tusk's Vault — environment configuration
# =============================================================================
# Copy this file to `.env.local` and fill in only the keys you need.
# `.env.local` is gitignored — it never gets pushed to GitHub.
#
# You only need ONE provider's API key, plus a Discord token if you want the
# Discord bot. Pick your provider in the dashboard's Settings panel.
# =============================================================================

# Discord bot token (required to chat with Tusk in Discord).
# Get one from https://discord.com/developers/applications → your app → Bot.
# Make sure "Message Content Intent" is enabled under Privileged Gateway Intents.
DISCORD_TOKEN=

# --- LLM providers (pick one or more) -----------------------------------------

# Anthropic and OpenAI have no direct key slot. OpenRouter (below) reaches
# the same Claude and GPT models on one key and one bill, so keeping separate
# slots to talk to two labs bought nothing.
#
# Do NOT set ANTHROPIC_API_KEY here. The Claude Code connection answers
# through your existing subscription, and it strips ANTHROPIC_API_KEY,
# ANTHROPIC_AUTH_TOKEN and ANTHROPIC_BASE_URL from the CLI's environment
# precisely because a stray key takes precedence inside the CLI and bills the
# API instead of the subscription you already pay for.

# Google Gemini. Get a key from https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# OpenRouter. One key reaches ~400 models across every major lab.
# Get a key from https://openrouter.ai/keys.
# Requests are routed only to hosts that do not retain prompts (your lore
# corpus travels with every question) — this is why most :free model
# variants are unavailable: they run on hosts that keep or train on prompts.
OPENROUTER_API_KEY=

# Ollama (local inference). No key required.
# Default works if `ollama serve` is running on the same machine.
OLLAMA_BASE_URL=http://localhost:11434

# --- Advanced --------------------------------------------------------------

# The dashboard binds to 127.0.0.1 by default so it's only reachable from this
# machine. If you intentionally want to expose it to your local network (e.g.
# running on a NAS or home server), set HOST=0.0.0.0. Only do this if you
# trust everyone on your LAN — the API can write your API keys and Discord
# token without authentication.
# HOST=0.0.0.0

# Override the default port (3000). If busy, the server auto-falls back to
# 3001, 3002, etc. — see the .port-runtime file the launcher writes.
# PORT=3000
