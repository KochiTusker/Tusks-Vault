{
  "name": "tusks-vault",
  "description": "Tusk's Vault — a locally-hosted fantasy-scribe AI that grounds D&D lore answers in your campaign documents.",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "update": "node scripts/update.mjs",
    "release": "node scripts/release-to-public.mjs",
    "release:dry-run": "node scripts/release-to-public.mjs --dry-run",
    "verify": "npm run lint && npm test && node scripts/audit-current-tree.mjs --dev-mode && node scripts/audit-security-contracts.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "audit:tree": "node scripts/audit-current-tree.mjs",
    "audit:dev": "node scripts/audit-current-tree.mjs --dev-mode",
    "audit:contracts": "node scripts/audit-security-contracts.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:uninstall": "bash scripts/test-uninstall.sh",
    "smoke-test": "node scripts/smoke-test.mjs",
    "docs:tone": "node scripts/docs-tone.mjs",
    "grade": "tsx scripts/grade-models.mjs",
    "grade:maturity": "tsx scripts/grade-maturity.mjs",
    "grades:emit": "tsx scripts/emit-grades.mjs",
    "probe:refusal": "tsx scripts/probe-refusal.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "env-paths": "^3.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "unified": "^11.0.5",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  }
}
